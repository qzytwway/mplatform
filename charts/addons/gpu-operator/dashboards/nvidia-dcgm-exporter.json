{
  "uid": "mplatform-gpu-dcgm-exporter",
  "title": "GPU / NVIDIA DCGM Exporter",
  "description": "GPU metrics from DCGM Exporter, adapted for MPlatform from the NVIDIA DCGM Exporter dashboard of dcgm-exporter 4.8.4 (Apache-2.0).",
  "tags": ["gpu", "dcgm"],
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Node",
        "type": "query",
        "query": "label_values(DCGM_FI_DEV_GPU_TEMP, instance)",
        "includeAll": true,
        "multi": true
      },
      {
        "name": "gpu",
        "label": "GPU",
        "type": "query",
        "query": "label_values(DCGM_FI_DEV_GPU_TEMP{instance=~\"$instance\"}, gpu)",
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "GPU Temperature (°C)",
      "gridPos": { "x": 0, "y": 0, "w": 18, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_FI_DEV_GPU_TEMP{instance=~\"$instance\", gpu=~\"$gpu\"}",
          "legendFormat": "{{instance}} GPU {{gpu}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "GPU Avg. Temp (°C)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 8 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 83 },
              { "color": "red", "value": 87 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(DCGM_FI_DEV_GPU_TEMP{instance=~\"$instance\", gpu=~\"$gpu\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "GPU Power Usage (W)",
      "gridPos": { "x": 0, "y": 8, "w": 18, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_FI_DEV_POWER_USAGE{instance=~\"$instance\", gpu=~\"$gpu\"}",
          "legendFormat": "{{instance}} GPU {{gpu}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "GPU Power Total (W)",
      "gridPos": { "x": 18, "y": 8, "w": 6, "h": 8 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 2400,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 1800 },
              { "color": "red", "value": 2200 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(DCGM_FI_DEV_POWER_USAGE{instance=~\"$instance\", gpu=~\"$gpu\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "GPU Utilization",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_FI_DEV_GPU_UTIL{instance=~\"$instance\", gpu=~\"$gpu\"}",
          "legendFormat": "{{instance}} GPU {{gpu}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "GPU SM Clocks (MHz)",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_FI_DEV_SM_CLOCK{instance=~\"$instance\", gpu=~\"$gpu\"}",
          "legendFormat": "{{instance}} GPU {{gpu}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "GPU Framebuffer Mem Used",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_FI_DEV_FB_USED{instance=~\"$instance\", gpu=~\"$gpu\"} * 1048576",
          "legendFormat": "{{instance}} GPU {{gpu}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tensor Core Utilization",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_FI_PROF_PIPE_TENSOR_ACTIVE{instance=~\"$instance\", gpu=~\"$gpu\"}",
          "legendFormat": "{{instance}} GPU {{gpu}}"
        }
      ]
    }
  ]
}
