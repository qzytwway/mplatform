#!/usr/bin/env bash
# Initializes the first control plane.
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C

bash /var/lib/mplatform/scripts/reset.sh retry
{{- if .KubeVIP }}
# kubeadm >= 1.29 binds admin.conf to cluster-admin late in init, so kube-vip
# uses super-admin.conf until init is done.
mkdir -p /etc/kubernetes/manifests
install -m 0600 /etc/kubernetes/mplatform/kube-vip-init.yaml /etc/kubernetes/manifests/kube-vip.yaml
{{- end }}
echo "==> kubeadm init"
kubeadm init --config /etc/kubernetes/mplatform/kubeadm-init.yaml{{ if .UploadCerts }} --upload-certs{{ end }}
{{- if .KubeVIP }}
install -m 0600 /etc/kubernetes/mplatform/kube-vip.yaml /etc/kubernetes/manifests/kube-vip.yaml
{{- end }}
