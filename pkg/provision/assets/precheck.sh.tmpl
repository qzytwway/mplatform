#!/usr/bin/env bash
# Collects facts for the MPlatform precheck as key=value lines. It never
# changes the host.
set -uo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C

fact() { printf '%s=%s\n' "$1" "$2"; }

. /etc/os-release 2>/dev/null || true
fact uid "$(id -u)"
fact hostname "$(cat /proc/sys/kernel/hostname)"
fact os_id "${ID:-}"
fact os_like "${ID_LIKE:-}"
fact os_version "${VERSION_ID:-}"
fact os_name "${PRETTY_NAME:-}"
fact arch "$(uname -m)"
fact cgroup "$(stat -fc %T /sys/fs/cgroup 2>/dev/null)"
fact cpu "$(nproc 2>/dev/null)"
fact mem_kib "$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)"
fact var_avail_kib "$(df -Pk /var 2>/dev/null | awk 'NR==2 {print $4}')"
fact product_uuid "$(cat /sys/class/dmi/id/product_uuid 2>/dev/null)"
macs=""
for dev in /sys/class/net/*; do
  [ -e "$dev/device" ] && macs="$macs,$(cat "$dev/address" 2>/dev/null)"
done
fact macs "${macs#,}"
fact addrs "$(ip -o -4 addr show 2>/dev/null | awk '{print $2"="$4}' | paste -sd, -)"
fact listening "$(ss -Htln 2>/dev/null | awk '{print $4}' | sed 's/.*://' | sort -un | paste -sd, -)"

cluster=""
for path in /etc/kubernetes/kubelet.conf /etc/kubernetes/admin.conf /etc/kubernetes/manifests/kube-apiserver.yaml /var/lib/etcd/member; do
  [ -e "$path" ] && cluster="$cluster,$path"
done
fact residue_cluster "${cluster#,}"
other=""
for bin in kubelet kubeadm containerd dockerd; do
  command -v "$bin" >/dev/null 2>&1 && other="$other,$(command -v "$bin")"
done
for unit in containerd docker; do
  systemctl is-active --quiet "$unit" 2>/dev/null && other="$other,$unit.service"
done
[ -d /etc/kubernetes ] && other="$other,/etc/kubernetes"
fact residue_other "${other#,}"

fact ntp "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)"
fact epoch "$(date +%s)"

case "$(uname -m)" in
  x86_64) arch=amd64 ;;
  aarch64 | arm64) arch=arm64 ;;
  *) arch=amd64 ;;
esac
probe() {
  local kind=$1 url=${2//@ARCH@/$arch} code
  if ! command -v curl >/dev/null 2>&1; then
    fact probe "$kind nocurl $url"
    return
  fi
  if [ "$kind" = file ]; then
    code=$(curl -s -o /dev/null -L --range 0-0 --max-time 15 -w '%{http_code}' "$url" 2>/dev/null)
  else
    code=$(curl -s -o /dev/null -L --max-time 15 -w '%{http_code}' "$url" 2>/dev/null)
  fi
  fact probe "$kind ${code:-000} $url"
}
{{- range .Probes }}
probe {{ shq .Kind }} {{ shq .URL }}
{{- end }}
{{- if .VIP }}
if ! command -v ping >/dev/null 2>&1; then
  fact vip_in_use unknown
elif ping -c 2 -W 1 {{ shq .VIP }} >/dev/null 2>&1; then
  fact vip_in_use yes
else
  fact vip_in_use no
fi
{{- end }}
