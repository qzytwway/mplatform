{
  "name": "@mplatform/plugin-sdk",
  "version": "0.16.0",
  "description": "Standalone SDK and build tools for MPlatform frontend plugins",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./resources": {
      "types": "./src/resources.ts",
      "import": "./src/resources.ts",
      "default": "./src/resources.ts"
    },
    "./k8s": {
      "types": "./src/k8s.ts"
    },
    "./hooks": {
      "types": "./src/hooks.ts",
      "import": "./src/hooks.ts",
      "default": "./src/hooks.ts"
    },
    "./ui": {
      "types": "./src/ui.ts",
      "import": "./src/ui.ts",
      "default": "./src/ui.ts"
    },
    "./navigation": {
      "types": "./src/navigation.tsx",
      "import": "./src/navigation.tsx",
      "default": "./src/navigation.tsx"
    },
    "./i18n": {
      "types": "./src/i18n.ts",
      "import": "./src/i18n.ts",
      "default": "./src/i18n.ts"
    },
    "./observability": {
      "types": "./src/observability.ts",
      "import": "./src/observability.ts",
      "default": "./src/observability.ts"
    },
    "./api": {
      "types": "./src/api.ts",
      "import": "./src/api.ts",
      "default": "./src/api.ts"
    },
    "./vite": {
      "types": "./src/vite.ts",
      "import": "./src/vite.ts",
      "default": "./src/vite.ts"
    },
    "./validation": {
      "types": "./src/validation.ts",
      "import": "./src/validation.ts",
      "default": "./src/validation.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mplatform-plugin": "./bin/mplatform-plugin.js"
  },
  "scripts": {
    "type-check": "tsc --noEmit -p tsconfig.json",
    "build": "rm -rf dist && tsc -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./resources": {
        "types": "./dist/resources.d.ts",
        "import": "./dist/resources.js",
        "default": "./dist/resources.js"
      },
      "./k8s": {
        "types": "./dist/k8s.d.ts"
      },
      "./hooks": {
        "types": "./dist/hooks.d.ts",
        "import": "./dist/hooks.js",
        "default": "./dist/hooks.js"
      },
      "./ui": {
        "types": "./dist/ui.d.ts",
        "import": "./dist/ui.js",
        "default": "./dist/ui.js"
      },
      "./navigation": {
        "types": "./dist/navigation.d.ts",
        "import": "./dist/navigation.js",
        "default": "./dist/navigation.js"
      },
      "./i18n": {
        "types": "./dist/i18n.d.ts",
        "import": "./dist/i18n.js",
        "default": "./dist/i18n.js"
      },
      "./observability": {
        "types": "./dist/observability.d.ts",
        "import": "./dist/observability.js",
        "default": "./dist/observability.js"
      },
      "./api": {
        "types": "./dist/api.d.ts",
        "import": "./dist/api.js",
        "default": "./dist/api.js"
      },
      "./vite": {
        "types": "./dist/vite.d.ts",
        "import": "./dist/vite.js",
        "default": "./dist/vite.js"
      },
      "./validation": {
        "types": "./dist/validation.d.ts",
        "import": "./dist/validation.js",
        "default": "./dist/validation.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@module-federation/vite": "1.21.3",
    "jiti": "2.7.0",
    "kubernetes-types": "^1.30.0",
    "semver": "7.8.5",
    "tar": "7.5.22"
  },
  "peerDependencies": {
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.2.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-table": "^8.0.0",
    "i18next": "^25.10.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.0.0",
    "react-router-dom": "^7.0.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/semver": "7.8.0",
    "typescript": "6.0.3"
  }
}
