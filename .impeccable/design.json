  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Default action; steel ink fill, 4px corners.",
      "html": "<button class=\"ds-btn-primary\">Create Inference Service</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:8px;height:36px;padding:8px 16px;border:0;border-radius:4px;background:var(--primary);color:var(--primary-foreground);font:500 14px/20px var(--font-sans);box-shadow:0 1px 2px 0 rgb(0 0 0 / 0.05);cursor:pointer;transition:all .15s}.ds-btn-primary:hover{background:color-mix(in oklch,var(--primary) 90%,transparent)}.ds-btn-primary:focus-visible{outline:none;box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent)}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Secondary page actions; hairline border, steel-accent hover.",
      "html": "<button class=\"ds-btn-outline\">Add Model</button>",
      "css": ".ds-btn-outline{display:inline-flex;align-items:center;height:36px;padding:8px 16px;border:1px solid var(--border);border-radius:4px;background:var(--background);color:var(--foreground);font:500 14px/20px var(--font-sans);box-shadow:0 1px 2px 0 rgb(0 0 0 / 0.05);cursor:pointer;transition:all .15s}.ds-btn-outline:hover{background:var(--accent);color:var(--accent-foreground)}.ds-btn-outline:focus-visible{outline:none;border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent)}"
    },
    {
      "name": "Ruled Figure Strip",
      "kind": "custom",
      "refersTo": "stat-strip-cell",
      "description": "Summary measurements as one ruled strip: rules above and below, hairlines between cells, mono tabular figures.",
      "html": "<section class=\"ds-strip\"><a class=\"ds-strip-cell\" href=\"#\"><span class=\"ds-strip-label\">Services ready</span><span class=\"ds-strip-fig\">3 / 4</span><span class=\"ds-strip-detail ds-strip-alert\">1 not ready</span></a><a class=\"ds-strip-cell\" href=\"#\"><span class=\"ds-strip-label\">GPU allocated</span><span class=\"ds-strip-fig\">12 / 80</span><span class=\"ds-strip-detail\">vGPU 15%</span></a><div class=\"ds-strip-cell\"><span class=\"ds-strip-label\">P95 TTFT</span><span class=\"ds-strip-fig\">182 ms</span><span class=\"ds-strip-detail\">last 24 h</span></div></section>",
      "css": ".ds-strip{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid var(--border);border-bottom:1px solid var(--border);color:var(--foreground);font-family:var(--font-sans)}.ds-strip-cell{display:flex;min-width:0;flex-direction:column;gap:4px;padding:16px 20px;color:inherit;text-decoration:none}.ds-strip-cell+.ds-strip-cell{border-left:1px solid var(--border)}a.ds-strip-cell:hover{background:color-mix(in oklch,var(--muted) 50%,transparent)}a.ds-strip-cell:focus-visible{outline:2px solid color-mix(in oklch,var(--ring) 50%,transparent)}.ds-strip-label{font-size:14px;color:var(--muted-foreground)}.ds-strip-fig{font:600 24px/32px var(--font-mono);font-variant-numeric:tabular-nums}.ds-strip-detail{font-size:14px;color:var(--muted-foreground);font-variant-numeric:tabular-nums}.ds-strip-alert{color:var(--destructive)}"
    },
    {
      "name": "Severity Band (critical)",
      "kind": "custom",
      "refersTo": "severity-band-critical",
      "description": "Top-of-overview band; border and fill take the worst live severity.",
      "html": "<section class=\"ds-band ds-band-critical\"><header class=\"ds-band-head\"><h2>Needs attention</h2><span class=\"ds-band-count\">2</span></header><div class=\"ds-band-body\"><h3 class=\"ds-band-group\">Critical 1</h3><a class=\"ds-band-item\" href=\"#\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12 6.477 2 12 2zm.01 13l-.127.007a1 1 0 0 0 0 1.986L12 17l.127-.007a1 1 0 0 0 0-1.986L12.01 15zM12 7a1 1 0 0 0-.993.883L11 8v4l.007.117a1 1 0 0 0 1.986 0L13 12V8l-.007-.117A1 1 0 0 0 12 7z\"/></svg><span>9 alerts firing</span><span class=\"ds-band-action\">View alerts</span></a></div></section>",
      "css": ".ds-band{border:1px solid var(--border);border-radius:4px;color:var(--foreground);font-family:var(--font-sans)}.ds-band-critical{border-color:color-mix(in oklch,var(--destructive) 40%,transparent);background:color-mix(in oklch,var(--destructive) 10%,transparent)}.ds-band-head{display:flex;align-items:center;gap:8px;padding:12px 16px;border-bottom:1px solid;border-color:inherit}.ds-band-head h2{margin:0;font-size:14px;font-weight:600}.ds-band-count{padding:2px 8px;border-radius:4px;background:var(--secondary);color:var(--secondary-foreground);font-size:12px;font-weight:500;font-variant-numeric:tabular-nums}.ds-band-body{padding:8px}.ds-band-group{margin:0;padding:4px 8px 2px;font-size:12px;font-weight:500;color:var(--destructive)}.ds-band-item{display:flex;align-items:center;gap:8px;padding:6px 8px;border-radius:4px;font-size:14px;color:inherit;text-decoration:none}.ds-band-item svg{flex-shrink:0;color:var(--destructive)}.ds-band-item:hover{background:color-mix(in oklch,var(--background) 60%,transparent)}.ds-band-item:focus-visible{outline:2px solid color-mix(in oklch,var(--ring) 50%,transparent)}.ds-band-action{margin-left:auto;font-size:12px;color:var(--muted-foreground)}"
    },
    {
      "name": "Severity Band (clear)",
      "kind": "custom",
      "refersTo": "severity-band-calm",
      "description": "The band when nothing needs attention: hairline border only, green all-good line.",
      "html": "<section class=\"ds-band-calm\"><header>Needs attention</header><p><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M17 3.34A10 10 0 1 1 2 12l.005-.324A10 10 0 0 1 17 3.34zm-1.293 5.953a1 1 0 0 0-1.32-.083l-.094.083L11 12.585l-1.293-1.292-.094-.083a1 1 0 0 0-1.403 1.403l.083.094 2 2 .094.083a1 1 0 0 0 1.226 0l.094-.083 4-4 .083-.094a1 1 0 0 0-.083-1.32z\"/></svg>All services are healthy</p></section>",
      "css": ".ds-band-calm{border:1px solid var(--border);border-radius:4px;color:var(--foreground);font-family:var(--font-sans)}.ds-band-calm header{padding:12px 16px;border-bottom:1px solid var(--border);font-size:14px;font-weight:600}.ds-band-calm p{display:flex;align-items:center;gap:8px;margin:0;padding:12px 16px;font-size:14px;color:var(--muted-foreground)}.ds-band-calm svg{color:var(--success)}"
    },
    {
      "name": "Summary Cell",
      "kind": "custom",
      "refersTo": "summary-cell",
      "description": "Resource-detail summary strip cell; numbers mono, words sans.",
      "html": "<div class=\"ds-summary\"><div class=\"ds-summary-cell\"><div class=\"ds-summary-label\">Status</div><div class=\"ds-summary-val\">Running</div></div><div class=\"ds-summary-cell\"><div class=\"ds-summary-label\">Ready</div><div class=\"ds-summary-val ds-mono\">1 / 1</div><div class=\"ds-summary-label\">containers</div></div><div class=\"ds-summary-cell\"><div class=\"ds-summary-label\">Restarts</div><div class=\"ds-summary-val ds-mono\">0</div></div></div>",
      "css": ".ds-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid var(--border);border-bottom:1px solid var(--border);color:var(--foreground);font-family:var(--font-sans)}.ds-summary-cell{min-width:0;padding:12px 16px}.ds-summary-cell+.ds-summary-cell{border-left:1px solid var(--border)}.ds-summary-label{font-size:12px;color:var(--muted-foreground)}.ds-summary-val{margin-top:8px;font-size:18px;line-height:28px;font-weight:600;font-variant-numeric:tabular-nums}.ds-mono{font-family:var(--font-mono)}"
    },
    {
      "name": "Sidebar Rail",
      "kind": "nav",
      "refersTo": "sidebar-rail",
      "description": "Deep steel rail in both themes; solid active fill; solid red alert count.",
      "html": "<nav class=\"ds-rail\"><div class=\"ds-rail-group\">Model Serving</div><a class=\"ds-rail-item ds-rail-active\" href=\"#\">Workbench</a><a class=\"ds-rail-item\" href=\"#\">Inference Services</a><div class=\"ds-rail-group\">Observability</div><a class=\"ds-rail-item\" href=\"#\">Active Alerts<span class=\"ds-rail-count\">9</span></a></nav>",
      "css": ".ds-rail{display:flex;flex-direction:column;gap:2px;width:220px;padding:8px;background:var(--sidebar);color:var(--sidebar-foreground);font:14px/20px var(--font-sans)}.ds-rail-group{padding:8px 8px 2px;font-size:12px;color:color-mix(in oklch,var(--sidebar-foreground) 70%,transparent)}.ds-rail-item{display:flex;align-items:center;height:28px;padding:0 8px;border-radius:4px;color:inherit;text-decoration:none}.ds-rail-item:hover{background:var(--sidebar-accent);color:var(--sidebar-accent-foreground)}.ds-rail-item:focus-visible{outline:2px solid var(--sidebar-ring)}.ds-rail-active,.ds-rail-active:hover{background:var(--sidebar-primary);color:var(--sidebar-primary-foreground);font-weight:500}.ds-rail-count{margin-left:auto;padding:0 6px;border-radius:9999px;background:var(--destructive);color:var(--background);font-size:11px;font-weight:500;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Capacity Row",
      "kind": "custom",
      "refersTo": "capacity-bar",
      "description": "GPU node row: status dot, name, mono allocation, steel capacity bar.",
      "html": "<div class=\"ds-cap\"><div class=\"ds-cap-row\"><span class=\"ds-cap-dot\"></span><span class=\"ds-cap-name\">gpu-node-01</span><span class=\"ds-cap-hint\">vGPU</span><span class=\"ds-cap-fig\">6 / 8</span></div><div class=\"ds-cap-track\"><div class=\"ds-cap-fill\" style=\"width:75%\"></div></div></div>",
      "css": ".ds-cap{color:var(--foreground);font:14px/20px var(--font-sans)}.ds-cap-row{display:flex;align-items:baseline;gap:8px}.ds-cap-dot{width:6px;height:6px;align-self:center;border-radius:9999px;background:var(--success)}.ds-cap-name{font-weight:500}.ds-cap-hint{font-size:12px;color:var(--muted-foreground)}.ds-cap-fig{margin-left:auto;font:12px/16px var(--font-mono);font-variant-numeric:tabular-nums}.ds-cap-track{margin-top:6px;height:6px;overflow:hidden;border-radius:9999px;background:var(--muted)}.ds-cap-fill{height:100%;border-radius:9999px;background:var(--chart-1)}"
    }
  ],
  "narrative": {
    "northStar": "The Control Room",
    "overview": "MPlatform reads like a status board, not a gallery of tiles. What is wrong sits at the top of an overview in its severity colour; everything else is ruled rows of measurements. The world is steel ink: every neutral, in both themes, carries the same small blue-steel tint (hue 262, taken from the logo blue), and the navigation is a committed deep steel rail that is visibly its own surface in light and dark alike. Hue anywhere else belongs to status and nothing else.\n\nDensity is operator density. Overview figures sit in strips divided by hairline rules instead of being boxed one per card; measurements are set in the system monospace with tabular figures so columns of numbers align and scan; labels stay in the system sans at small sizes in the muted steel ink. Corners are tight (6px base). Depth is almost absent: the world separates content with 1px rules and tonal tints, not shadows.\n\nThe world is new and was applied to the shell and the three densest overview surfaces (model-serving Workbench, cluster overview, workload and Pod detail summaries). Many secondary panels (charts, events, information blocks, forms, list pages) still use the inherited shadcn Card container; that is legacy, not the pattern for new surfaces.",
    "keyCharacteristics": [
      "Steel-tinted neutrals (hue 262) in both themes; no zero-chroma grey.",
      "A deep steel sidebar rail in both themes, with a brighter steel fill marking the active item.",
      "Status hues (red, amber, green, blue) carry meaning only.",
      "Summary figures in hairline-ruled strips, set mono and tabular.",
      "A severity band at the top of an overview whose fill is the worst live severity.",
      "Tight 6px base radius; flat surfaces; steel focus ring, caret and selection."
    ],
    "rules": [
      {
        "name": "The Status Hue Rule",
        "body": "Red, amber, green and blue mean critical, warning, healthy and info, and appear only when they carry that meaning. The cluster overview dropped its colour-coded icon tiles and the GPU capacity bar moved off the info blue to Capacity Steel for this reason: an inventory count or an allocation is not a status.",
        "section": "colors"
      },
      {
        "name": "The One Tint Rule",
        "body": "Every neutral carries the same hue (262) at low chroma, in both themes. Don't introduce a zero-chroma grey or a second neutral hue.",
        "section": "colors"
      },
      {
        "name": "The Figure Rule",
        "body": "A value that is a number, or a string made only of digits, spaces, slashes, dots and commas (a count or a ratio such as \"3 / 4\"), is set in the mono with tabular figures. Words stay in the sans even when they sit in a figure slot (a status like \"Running\").",
        "section": "typography"
      },
      {
        "name": "The Rule-Not-Box Rule",
        "body": "On overview surfaces, group by hairline rules and alignment, not by wrapping each item in a bordered, shadowed card.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do put the severity band first on an overview and colour it by the worst live item.",
      "Do lay summary measurements out as a ruled figure strip: rules above and below, hairlines between cells, no per-cell box.",
      "Do set every number or count/ratio in the system mono with tabular figures (the Figure Rule).",
      "Do keep neutrals on the single steel tint (hue 262) and use the steel ring for focus, caret and selection.",
      "Do show the current cluster in the header wherever it changes what the user sees.",
      "Do keep the sidebar a deep steel rail in both themes, with the active item as a solid Rail Active fill."
    ],
    "donts": [
      "Don't use red, amber, green or blue for anything that is not a status (no colour-coded icon tiles, no info-blue capacity bars).",
      "Don't wrap each figure of a summary in its own bordered card.",
      "Don't add decorative shadows; separate with hairlines and tints.",
      "Don't introduce zero-chroma greys or a second neutral hue.",
      "Don't treat the 10px Card corner as the house radius for new surfaces."
    ]
  }
}